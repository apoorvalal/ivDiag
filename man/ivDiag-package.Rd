\name{ivDiag-package}
\alias{ivDiag-package}
\docType{package}
\title{IV Estimation and Diagnostics}
\description{Conducts various estimation and diagnostic procedure for instrumental variable designs in one shot.}
\details{
  Provides estimation and diagnostic tools for instrumental variables designs with one endogenous treatment, implementing the guidelines in Lal et al. (2024): bootstrapped confidence intervals, several first-stage F statistics including the effective F statistic, the Anderson-Rubin test and its confidence set, the tF procedure, local-to-zero sensitivity tests, and an option for fuzzy regression discontinuity designs.

  See \code{\link{ivDiag}} for details.
}
\author{
  Apoorva Lal; Yiqing Xu
}
\references{
Lal, Apoorva, Mackenzie Lockhart, Yiqing Xu, and Ziwen Zu. 2024. "How Much Should We Trust Instrumental Variable Estimates in Political Science? Practical Advice Based on 67 Replicated Studies." Political Analysis 32 (4): 521--540. \doi{10.1017/pan.2024.2}
}
